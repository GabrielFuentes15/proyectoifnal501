                            <!-- CAMBIAR: Nombre del estudiante -->
                            <strong>Roberto S.</strong> <small class="text-muted">- Competidor</small>
                        </footer>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sección de Suscripción a Newsletter -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <!-- CAMBIAR: Título de la sección -->
                <h2 class="display-5 fw-bold mb-3">Suscríbete a Nuestro Newsletter</h2>
                <!-- CAMBIAR: Descripción de la sección -->
                <p class="lead mb-4">
                    Recibe tips gratuitos, técnicas exclusivas y actualizaciones sobre nuevos programas.
                </p>
                
                <!-- NOTA: Este formulario no tiene backend funcional, solo es visual -->
                <!-- CAMBIAR: Si quieres integrar un servicio de newsletter real (Mailchimp, etc.), 
                     cambia la acción del formulario -->
                <form class="row g-3 justify-content-center" method="POST" action="/newsletter">
                    <div class="col-md-8">
                        <input type="email" class="form-control form-control-lg" 
                               placeholder="Tu email" name="email" required>
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-light btn-lg px-5">
                            Suscribirse
                        </button>
                    </div>
                </form>
                
                <!-- CAMBIAR: Texto de privacidad -->
                <small class="d-block mt-3 opacity-75">
                    <i class="fas fa-lock me-1"></i>
                    No compartimos tu información. Cancela tu suscripción en cualquier momento.
                </small>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
