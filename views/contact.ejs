            <strong>¡Mensaje enviado!</strong> Te responderemos lo antes posible.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
</section>
<% } %>

<!-- Sección de Contacto -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Formulario de Contacto -->
            <div class="col-lg-8 mb-5 mb-lg-0">
                <h2 class="h3 fw-bold mb-4">Envíanos un Mensaje</h2>
                
                <!-- CAMBIAR: Este formulario envía a POST /contact (simulado) -->
                <!-- Si quieres integrar un servicio real de envío de correos (Nodemailer, SendGrid, etc.),
                     modifica la ruta en routes/index.js -->
                <form method="POST" action="/contact" class="needs-validation" novalidate>
                    <div class="row g-3">
                        <!-- Campo: Nombre -->
                        <div class="col-md-6">
                            <label for="name" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <!-- CAMBIAR: Placeholder del campo -->
                            <input type="text" class="form-control" id="name" name="name" 
                                   placeholder="Tu nombre" required>
                            <div class="invalid-feedback">
                                Por favor ingresa tu nombre.
                            </div>
                        </div>
                        
                        <!-- Campo: Email -->
                        <div class="col-md-6">
                            <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                            <!-- CAMBIAR: Placeholder del campo -->
                            <input type="email" class="form-control" id="email" name="email" 
                                   placeholder="tu@email.com" required>
                            <div class="invalid-feedback">
                                Por favor ingresa un email válido.
                            </div>
                        </div>
                        
                        <!-- Campo: Asunto -->
                        <div class="col-12">
                            <label for="subject" class="form-label">Asunto <span class="text-danger">*</span></label>
                            <!-- CAMBIAR: Placeholder del campo -->
                            <input type="text" class="form-control" id="subject" name="subject" 
                                   placeholder="Asunto de tu mensaje" required>
                            <div class="invalid-feedback">
                                Por favor ingresa un asunto.
                            </div>
                        </div>
                        
                        <!-- Campo: Mensaje -->
                        <div class="col-12">
                            <label for="message" class="form-label">Mensaje <span class="text-danger">*</span></label>
                            <!-- CAMBIAR: Placeholder del campo y número de filas -->
                            <textarea class="form-control" id="message" name="message" rows="6" 
                                      placeholder="Escribe tu mensaje aquí..." required></textarea>
                            <div class="invalid-feedback">
                                Por favor ingresa tu mensaje.
                            </div>
                        </div>
                        
                        <!-- Botón de Envío -->
                        <div class="col-12">
                            <!-- CAMBIAR: Texto del botón -->
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-paper-plane me-2"></i>Enviar Mensaje
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            
            <!-- Información de Contacto -->
            <div class="col-lg-4">
                <h2 class="h3 fw-bold mb-4">Información de Contacto</h2>
                
                <!-- CAMBIAR: Información de contacto -->
                <div class="mb-4">
                    <div class="d-flex align-items-start mb-3">
