                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Dirección</h5>
                            <!-- CAMBIAR: Dirección -->
                            <p class="text-muted mb-0">
                                <a href="https://www.bing.com/maps/search?v=2&pc=FACEBK&mid=8100&mkt=es-MX&fbclid=IwY2xjawOfKhxleHRuA2FlbQIxMABicmlkETFwbHBvM1M1WDJsWlgyR0xlc3J0YwZhcHBfaWQQMjIyMDM5MTc4ODIwMDg5MgABHjr0EJUPm_49Jry1WoPKvBhG5uEZZ98NaDa8X-TJP8xrM8yEJNOtDqbpFjGr_aem_qh2pN62nCe6CJhkobcJnHg&FORM=FBKPL1&q=Sim%C3%B3n+%C3%81lvarez+%23202+g%2C+col.+heroes+de+Chapultepec+%2C+Le%C3%B3n+Centro%2C+Mexico%2C+37190&cp=21.136903%7E-101.677883&lvl=16&style=r" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                Simón Álvarez #202 g, col. heroes de Chapultepec,<br>
                                León Centro, Mexico, <br>
                                37190
                                </a>
                            </p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-start mb-3">
                        <div class="bg-primary text-white rounded-circle p-3 me-3">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Teléfono</h5>
                            <!-- CAMBIAR: Teléfono -->
                            <p class="text-muted mb-0">
                                <a href="tel:+524771347339" class="text-decoration-none">
                                    +52 (477) 134 7339
                                </a>
                            </p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-start mb-3">
                        <div class="bg-primary text-white rounded-circle p-3 me-3">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Email</h5>
                            <!-- CAMBIAR: Email -->
                            <p class="text-muted mb-0">
                                <a href="mailto:contacto@kamt.com.mx" class="text-decoration-none">
                                    contacto@kamt.com.mx
                                </a>
                            </p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-start mb-3">
                        <div class="bg-primary text-white rounded-circle p-3 me-3">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Horario de Atención</h5>
                            <!-- CAMBIAR: Horario -->
                            <p class="text-muted mb-0">
                                Lunes - Jueves: 6:30 AM - 9:30 AM <br>
                                                y 6:00 PM - 9:00 PM<br>
                                Viernes: Cerrado <br>
                                Sábados: 08:30 AM - 10:00 AM<br>
