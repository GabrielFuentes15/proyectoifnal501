                <!-- CAMBIAR: Agrega o quita elementos del menú según tus necesidades -->
                <li class="nav-item">
                    <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>" 
                       href="/">Inicio</a>
