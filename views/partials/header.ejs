<!-- ============================================================================
     HEADER PARCIAL - Incluye meta tags, Bootstrap CDN, y CSS personalizado
     ============================================================================
     
     CAMBIAR AQUÍ:
     - Título de la página (se pasa como variable 'title' desde cada ruta)
     - Meta description (línea 14)
     - Keywords (línea 15)
     - Google Fonts si quieres cambiar las tipografías (línea 26)
     ============================================================================ -->

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CAMBIAR: Meta description para SEO -->
    <meta name="description" content="HA MUAY THAI GYM - Academia de Muay Thai profesional. Aprende técnicas, programas de entrenamiento y más.">
    <!-- CAMBIAR: Keywords para SEO -->
    <meta name="keywords" content="muay thai, entrenamiento, artes marciales, boxeo tailandés, ha muay thai gym">
    <title><%= typeof title !== 'undefined' ? title : 'HA MUAY THAI GYM' %></title>
    
    <!-- Bootstrap 5.3 desde CDN -->
    <!-- CAMBIAR: Si quieres usar otra versión de Bootstrap, cambia la URL -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" 
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    
    <!-- Font Awesome para iconos -->
    <!-- CAMBIAR: Si prefieres otro conjunto de iconos, puedes cambiarlo o eliminarlo -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <!-- CAMBIAR: Si quieres cambiar las fuentes, busca otras en fonts.google.com y reemplaza -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Oswald:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- CSS Personalizado -->
    <!-- CAMBIAR: Todos los estilos personalizables están en public/css/styles.css -->
    <link rel="stylesheet" href="/css/styles.css">
</head>
